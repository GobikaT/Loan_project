# ---- Database ----
DB_HOST=localhost
DB_PORT=3306
DB_NAME=loan_eligibility_system
DB_USER=loan_app_user
DB_PASSWORD=change_me

# ---- JWT ----
JWT_SECRET_KEY=change_this_to_a_long_random_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---- App ----
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000
UPLOAD_DIR=./uploads

# ---- Initial Admin (used only by db/seed.py, never committed with real values) ----
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=change_me_before_seeding
INITIAL_ADMIN_NAME=System Administrator
